@model RaceDay.Mvc.ViewModels.RegisterVm

@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-heading">
            <span class="auth-icon">🏁</span>
            <h1>Create Account</h1>
            <p>Join RaceDay and get ready for your next event.</p>
        </div>

        <form asp-controller="Auth"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="FirstName">First Name</label>
                <input asp-for="FirstName"
                       class="form-control"
                       placeholder="Enter first name" />
                <span asp-validation-for="FirstName"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName">Last Name</label>
                <input asp-for="LastName"
                       class="form-control"
                       placeholder="Enter last name" />
                <span asp-validation-for="LastName"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter email"
                       autocomplete="email" />
                <span asp-validation-for="Email"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Create a password"
                       autocomplete="new-password" />
                <span asp-validation-for="Password"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Account Type</label>

                <select asp-for="Role" class="form-control">
                    <option value="Participant">Participant</option>
                    <option value="Organiser">Organiser</option>
                </select>

                <span asp-validation-for="Role"
                      class="field-error"></span>
            </div>

            <button type="submit" class="btn-raceday">
                Create Account
            </button>

        </form>

        <div class="auth-footer">
            Already have an account?
            <a asp-controller="Auth" asp-action="Login">
                Login here
            </a>
        </div>

    </div>
</div>
